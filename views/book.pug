extends layout 

block content 
    include _mixins
    a.back-link(href="/")
    i.fa-solid.fa-arrow-left
    | К списку

    .card 
        h1.card__title = book.title 

        .field 
            label(for="title") Название
            input#title.w3-input.w3-border(type="text", value=book.title)
        .field 
            label(for="author") Автор
            input#title.w3-input.w3-border(type="text", value=book.author)
        .field 
            label(for="year") Год
            input#title.w3-input.w3-border(type="number", value=book.year)
        
        .status(class=`status--${book.status}`)
            if book.status === 'available'
                p.status__title 
                    i.fa-solid.fa-building-columns
                    | В библиотеке
            else
                p.status__title 
                    i.fa-solid.fa-user 
                    | Выдана читателю
                p.status__text 
                    | #{book.borrower.name}, вернуть до #{formatDate(book.borrower.dueDate)}

        .card__actions 
            button.btn.btn--primary(type="button")
            i.fa-solid 
                | Сохранить
            if book.status === 'available'
                button.btn.btn--primary(type="button")
                i.fa-solid.fa-user-plus 
                    | Выдать
            else 
                button.btn.btn--secondary(type="button")
                i.fa-solid
                    | Вернуть
            button.btn.btn--danger.card__delete(type="button")
            i.fa-solid.fa-trash 
                | Удалить